{
  "name": "navbase",
  "version": "1.0.0-beta.1",
  "private": true,
  "description": "自用的网址导航管理平台，替代浏览器书签功能（Cloudflare Workers + D1）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baisuMr/NavBase.git"
  },
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8788",
    "dev:full": "concurrently \"pnpm dev\" \"pnpm dev:api\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "lunar-javascript": "^1.6.12",
    "pinia": "^4.0.3",
    "remixicon": "^4.9.1",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.34",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^10.0.5",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.3"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
